# apps/consumer, apps/api
DATABASE_URL=postgres://renewable_pulse:renewable_pulse@localhost:5434/renewable_pulse

# apps/ingest, apps/consumer — comma-separated list of Redpanda broker addresses
REDPANDA_BROKERS=localhost:19092

# apps/ingest, apps/consumer
READINGS_TOPIC=readings

# apps/ingest — Go duration string (e.g. 30m, 1h)
POLL_INTERVAL=1h

# apps/ingest — max concurrent in-flight Redpanda produce requests (backpressure bound)
MAX_IN_FLIGHT=64

# apps/ingest — ENTSO-E Transparency Platform API token (Norway pollers).
# Requires emailing transparency@entsoe.eu with "RESTful API access" in the
# subject; issued within ~3 business days (docs/architecture.md §3). Unset
# disables the ENTSO-E poller rather than failing ingest.
# ENTSOE_API_TOKEN=

# apps/ingest — EIA Open Data API key (USA poller). Instant self-serve at
# https://www.eia.gov/opendata/. Unset disables the EIA poller rather than
# failing ingest.
# EIA_API_KEY=

# apps/api
PORT=3001
HOST=0.0.0.0

# apps/api — comma-separated list of browser origins allowed for REST and the
# /live WebSocket upgrade. Keep this to real origins; the WebSocket endpoint
# is credential-capable and must not fall back to "*".
ALLOWED_ORIGINS=http://localhost:3000

# apps/api — Redpanda consumer group id for the in-process live-fanout
# consumer (distinct from apps/consumer's "persist" group).
LIVE_GROUP_ID=live

# apps/api — interval in ms between WebSocket heartbeat frames sent to
# connected /live clients.
LIVE_HEARTBEAT_MS=30000
