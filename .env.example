# apps/consumer, apps/api
DATABASE_URL=postgres://renewable_pulse:renewable_pulse@localhost:5434/renewable_pulse

# apps/ingest, apps/consumer — comma-separated list of Redpanda broker addresses
REDPANDA_BROKERS=localhost:19092

# apps/ingest, apps/consumer
READINGS_TOPIC=readings

# apps/ingest — Go duration string (e.g. 30m, 1h)
POLL_INTERVAL=1h

# apps/ingest — max concurrent in-flight Redpanda produce requests (backpressure bound)
MAX_IN_FLIGHT=64

# apps/api
PORT=3001
HOST=0.0.0.0
